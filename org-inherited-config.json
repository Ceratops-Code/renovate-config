{
  "baseBranchPatterns": [
    "release/local"
  ],
  "requireConfig": "optional",
  "onboarding": false,
  "automerge": false,
  "packageRules": [
    {
      "description": "Dependabot maintains supported packages; Renovate updates only the toolchain declarations enabled below.",
      "matchPackageNames": [
        "*"
      ],
      "enabled": false
    },
    {
      "description": "Update pinned Python and Node versions",
      "matchManagers": [
        "pyenv",
        "nvm",
        "nodenv"
      ],
      "enabled": true
    },
    {
      "description": "Update the Python version declared by Python projects",
      "matchManagers": [
        "pep621"
      ],
      "matchDepTypes": [
        "requires-python"
      ],
      "enabled": true
    },
    {
      "description": "Update the Python and Node versions used by CI",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "uses-with"
      ],
      "matchDepNames": [
        "python",
        "node"
      ],
      "enabled": true
    },
    {
      "description": "Update the Node runtime range declared by JavaScript projects",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "engines"
      ],
      "matchDepNames": [
        "node"
      ],
      "enabled": true
    },
    {
      "description": "Update declared pnpm versions",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "packageManager",
        "devEngines.packageManager"
      ],
      "matchDepNames": [
        "pnpm"
      ],
      "enabled": true
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "osvVulnerabilityAlerts": false,
  "dependencyDashboard": {
    "enabled": true
  }
}
